<Window x:Class="Vitrines.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Витрины — панель управления" Width="1120" Height="720"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closed="Window_Closed"
        Background="#0F1115">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C9CFF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#337C9CFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#161A22"/>
        <SolidColorBrush x:Key="Card2Brush" Color="#1C2230"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#2A3242"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8EDF7"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#9AA7BE"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6E7C95"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource Card2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#243044"/><Setter TargetName="bd" Property="BorderBrush" Value="#3A4760"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#2A3852"/><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" CornerRadius="10" Padding="12,7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter TargetName="bd" Property="Background" Value="{StaticResource Card2Brush}"/><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1A2130"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#121722"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="2"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="bd" Property="BorderThickness" Value="1"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1B2433"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#121722"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/><Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#121722"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/></Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="0,0,12,0">
                    <TextBlock Text="▣" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Витрины" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Умные стеклянные контейнеры, правила, авто-сортировка и контроль" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Экспорт…" Margin="0,0,8,0" Click="Export_Click"/>
                <Button Content="Импорт…" Click="Import_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <CheckBox x:Name="AutoToggle" Content="Автоматическая сортировка включена" VerticalAlignment="Center" Checked="AutoToggle_Changed" Unchecked="AutoToggle_Changed"/>
                        <Border Margin="14,0,0,0" Background="#101620" CornerRadius="8" Padding="10,5" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="620"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
                <WrapPanel Grid.Row="1" Margin="0,12,0,0" ItemHeight="34">
                    <Button Content="＋ Новая витрина" Margin="0,0,8,8" Click="NewVitrine_Click"/>
                    <Button Content="＋ Новый портал…" Margin="0,0,8,8" Click="NewPortal_Click"/>
                    <Button Content="Показать витрины" Margin="0,0,8,8" Click="ShowVitrines_Click"/>
                    <Button Content="Скрыть витрины" Margin="0,0,8,8" Click="HideVitrines_Click"/>
                    <Button Content="▶ Разобрать сейчас" Margin="0,0,8,8" Click="Scan_Click" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"/>
                    <Button Content="↶ Откатить 1" Margin="0,0,8,8" Click="Undo_Click"/>
                    <Button Content="↶ Откатить 5" Margin="0,0,8,8" Click="Undo5_Click"/>
                    <Button Content="Обновить" Margin="0,0,8,8" Click="Refresh_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <TabControl x:Name="MainTabs">
                <TabItem Header="Сводка">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Margin="0,0,10,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Источники наблюдения" FontWeight="SemiBold" FontSize="14" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="Добавить" Padding="10,5" Margin="8,0,0,0" Click="AddSource_Click"/>
                                    <Button Content="Удалить" Padding="10,5" Margin="6,0,0,0" Click="RemoveSource_Click"/>
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="SourcesList" Grid.Row="1"/>
                            <Border Grid.Row="2" Margin="0,10,0,0" Background="#121722" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10">
                                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Витрины" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <ListBox x:Name="VitrinesList" Grid.Row="1"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Правила">
                    <Grid Margin="6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,10" ItemHeight="34">
                            <Button Content="＋ Быстрое правило" Margin="0,0,8,8" Click="AddRule_Click" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"/>
                            <Button Content="＋ Расширенное…" Margin="0,0,8,8" Click="AddAdvancedRule_Click"/>
                            <Button Content="Изменить…" Margin="0,0,8,8" Click="EditRule_Click"/>
                            <Button Content="Вкл/выкл" Margin="0,0,8,8" Click="ToggleRule_Click"/>
                            <Button Content="↑ Выше" Margin="0,0,8,8" Click="MoveRuleUp_Click"/>
                            <Button Content="↓ Ниже" Margin="0,0,8,8" Click="MoveRuleDown_Click"/>
                            <Button Content="Исключение" Margin="0,0,8,8" Click="ToggleExclusionRule_Click"/>
                            <Button Content="Удалить" Margin="0,0,8,8" Click="DeleteRule_Click"/>
                            <Button Content="Пресеты" Margin="0,0,8,8" Click="Presets_Click"/>
                            <Button Content="Сохранить" Margin="0,0,8,8" Click="SaveRules_Click"/>
                        </WrapPanel>
                        <ListBox x:Name="RulesList" Grid.Row="1" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                        <Border Grid.Row="2" Margin="0,10,0,0" Background="#121722" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <TextBlock Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                                       Text="Правила идут сверху вниз (первое совпадение). Поддерживаются расширения, маски, тип, размер/даты (через расширенный редактор), источник, исключения и правило-исключение «не трогать». Политика для неподошедших — во вкладке «Вид и настройки»."/>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Неразобранное">
                    <Grid Margin="6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,10" ItemHeight="34">
                            <Button Content="В витрину…" Margin="0,0,8,8" Click="InboxMove_Click" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"/>
                            <Button Content="Показать в папке" Margin="0,0,8,8" Click="InboxReveal_Click"/>
                            <Button Content="Скрыть из списка" Margin="0,0,8,8" Click="InboxDismiss_Click"/>
                            <Button Content="Очистить решённые" Margin="0,0,8,8" Click="InboxClear_Click"/>
                            <TextBlock x:Name="InboxInfo" Margin="12,6,0,0" Foreground="{StaticResource TextDimBrush}"/>
                        </WrapPanel>
                        <ListBox x:Name="InboxList" Grid.Row="1" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                   Text="Сюда попадают файлы, которые не подошли под правила (если включена политика) или не удалось обработать. У каждого есть причина — можно быстро отправить в нужную витрину или скрыть."/>
                    </Grid>
                </TabItem>

                <TabItem Header="Журнал">
                    <Grid Margin="6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="История действий: что, куда, почему, правило и источник. Поддерживается откат нескольких операций." Foreground="{StaticResource TextDimBrush}"/>
                        <WrapPanel Grid.Row="1" Margin="0,8,0,8" ItemHeight="32">
                            <TextBlock Text="Событие:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextDimBrush}"/>
                            <ComboBox x:Name="HistoryEventFilter" Width="150" SelectionChanged="HistoryFilter_Changed">
                                <ComboBoxItem Content="Все" IsSelected="True"/>
                                <ComboBoxItem Content="Placed"/>
                                <ComboBoxItem Content="Moved"/>
                                <ComboBoxItem Content="Skipped"/>
                                <ComboBoxItem Content="Error"/>
                                <ComboBoxItem Content="SentToInbox"/>
                                <ComboBoxItem Content="Undone"/>
                                <ComboBoxItem Content="CreatedVitrine"/>
                            </ComboBox>
                            <TextBlock Text="Текст:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBox x:Name="HistoryTextFilter" Width="220" TextChanged="HistoryFilter_Changed"/>
                            <Button Content="Обновить журнал" Margin="12,0,0,0" Click="RefreshHistory_Click"/>
                        </WrapPanel>
                        <ListBox x:Name="HistoryList" Grid.Row="2" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Dry-run">
                    <Grid Margin="6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="Проверить папку…" Padding="12,6" Click="DryRun_Click"/>
                                <Button Content="Проверить все источники" Padding="12,6" Margin="8,0,0,0" Click="DryRunAll_Click"/>
                            </StackPanel>
                            <Border Margin="12,0,0,0" Background="#121722" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                                <TextBlock x:Name="DryRunInfo" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                            </Border>
                        </DockPanel>
                        <ListBox x:Name="DryRunList" Grid.Row="1" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Вид и настройки">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <TextBlock Text="Поведение и политика" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <WrapPanel ItemHeight="36">
                                <CheckBox x:Name="RecursiveWatch" Content="Рекурсивное наблюдение источников" Margin="0,0,16,8" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8"><TextBlock Text="Стабильность, сек:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextDimBrush}"/><TextBox x:Name="StableSecondsBox" Width="60"/></StackPanel>
                            </WrapPanel>
                            <WrapPanel ItemHeight="36">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8"><TextBlock Text="Если не подошло:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextDimBrush}"/>
                                    <ComboBox x:Name="UnmatchedPolicyBox" Width="180">
                                        <ComboBoxItem Content="Ignore (ничего)" Tag="Ignore"/>
                                        <ComboBoxItem Content="В «Неразобранное»" Tag="SendToInbox"/>
                                        <ComboBoxItem Content="В витрину по умолчанию" Tag="PlaceInVitrine"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8"><TextBlock Text="Витрина по умолчанию:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextDimBrush}"/><TextBox x:Name="UnmatchedVitrineBox" Width="160"/></StackPanel>
                            </WrapPanel>
                            <TextBlock Text="Глобальные исключения (не трогать)" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Папки (по строке на путь)" Foreground="{StaticResource TextDimBrush}"/><TextBox x:Name="ExcludeFoldersBox" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Расширения (через запятую)" Foreground="{StaticResource TextDimBrush}"/><TextBox x:Name="ExcludeExtBox" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Имя содержит (через запятую)" Foreground="{StaticResource TextDimBrush}"/><TextBox x:Name="ExcludeNameBox" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto"/></StackPanel>
                            </Grid>

                            <TextBlock Text="Внешний вид (кастомизация)" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,8"/>
                            <WrapPanel ItemHeight="36">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8"><TextBlock Text="Акцент (#RRGGBB):" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextDimBrush}"/><TextBox x:Name="AccentBox" Width="110"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8"><TextBlock Text="Размер плитки:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextDimBrush}"/><TextBox x:Name="TileSizeBox" Width="70"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8"><TextBlock Text="Плотность:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextDimBrush}"/>
                                    <ComboBox x:Name="DensityBox" Width="140"><ComboBoxItem Content="compact"/><ComboBoxItem Content="normal"/><ComboBoxItem Content="comfortable"/></ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8"><TextBlock Text="Масштаб шрифта:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextDimBrush}"/><TextBox x:Name="FontScaleBox" Width="70"/></StackPanel>
                            </WrapPanel>
                            <WrapPanel ItemHeight="32">
                                <CheckBox x:Name="AnimationsBox" Content="Анимации" Margin="0,0,16,8"/>
                            </WrapPanel>

                            <WrapPanel Margin="0,14,0,0" ItemHeight="34">
                                <Button Content="Сохранить настройки" Click="SaveSettings_Click" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" Margin="0,0,8,8"/>
                                <Button Content="Применить вид к витринам" Click="ApplyAppearance_Click" Margin="0,0,8,8"/>
                                <Button Content="Пересоздать витрины по правилам" Click="RebuildFromRules_Click" Margin="0,0,8,8"/>
                            </WrapPanel>

                            <Border Margin="0,10,0,0" Background="#121722" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10">
                                <TextBlock Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                                           Text="Экспорт/импорт (снапшоты) — кнопки в шапке. Хранение: %LOCALAPPDATA%\Vitrines (settings, rules, layout, inbox, history, storage). Витрины позиционируются в пределах экранов; при перезапуске оболочки они перепривязываются к слою рабочего стола."/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <TextBlock Grid.Row="3" Margin="4,10,4,0" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                   Text="Автоматика выключена по умолчанию. Каждое перемещение записывается в журнал и может быть отменено (в т.ч. несколькими шагами). Коллекции физически хранят файлы в %LOCALAPPDATA%\Vitrines\storage, порталы работают с реальными папками."/>
    </Grid>
</Window>