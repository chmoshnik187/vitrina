<Window x:Class="Vitrines.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Витрины — панель управления" Width="980" Height="640"
        MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closed="Window_Closed"
        Background="#0F1115">
    <Window.Resources>
        <Color x:Key="AccentColor">#7C9CFF</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C9CFF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#337C9CFF"/>
        <SolidColorBrush x:Key="BgBrush" Color="#0F1115"/>
        <SolidColorBrush x:Key="CardBrush" Color="#161A22"/>
        <SolidColorBrush x:Key="Card2Brush" Color="#1C2230"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#2A3242"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8EDF7"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#9AA7BE"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6E7C95"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource Card2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#243044"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A4760"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A3852"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" CornerRadius="10" Padding="14,8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Card2Brush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2130"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#121722"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B2433"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="0,0,12,0">
                    <TextBlock Text="▣" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Витрины" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Умные стеклянные контейнеры и авто-сортировка на рабочем столе" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1A2230" CornerRadius="10" Padding="10,6" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                    <TextBlock Text="Данные: %LOCALAPPDATA%\Vitrines" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Toolbar / status card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <CheckBox x:Name="AutoToggle" Content="Автоматическая сортировка включена"
                                  VerticalAlignment="Center" Checked="AutoToggle_Changed" Unchecked="AutoToggle_Changed"/>
                        <Border Margin="14,0,0,0" Background="#101620" CornerRadius="8" Padding="10,5" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
                <WrapPanel Grid.Row="1" Margin="0,12,0,0" ItemHeight="34">
                    <Button Content="＋ Новая витрина" Margin="0,0,8,8" Click="NewVitrine_Click"/>
                    <Button Content="＋ Новый портал…" Margin="0,0,8,8" Click="NewPortal_Click"/>
                    <Button Content="Показать витрины" Margin="0,0,8,8" Click="ShowVitrines_Click"/>
                    <Button Content="Скрыть витрины" Margin="0,0,8,8" Click="HideVitrines_Click"/>
                    <Button Content="▶ Разобрать сейчас" Margin="0,0,8,8" Click="Scan_Click" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"/>
                    <Button Content="Обновить" Margin="0,0,8,8" Click="Refresh_Click"/>
                    <Button Content="↶ Откатить последнее" Margin="0,0,8,8" Click="Undo_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <TabControl>
                <TabItem Header="Сводка">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Источники наблюдения" FontWeight="SemiBold" FontSize="14" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="Добавить" Padding="10,5" Margin="8,0,0,0" Click="AddSource_Click"/>
                                    <Button Content="Удалить" Padding="10,5" Margin="6,0,0,0" Click="RemoveSource_Click"/>
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="SourcesList" Grid.Row="1"/>
                            <Border Grid.Row="2" Margin="0,10,0,0" Background="#121722" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10">
                                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Витрины" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <ListBox x:Name="VitrinesList" Grid.Row="1"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Dry-run">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button Content="Выбрать папку и проверить…" Padding="12,6" Click="DryRun_Click" DockPanel.Dock="Left"/>
                            <Border Margin="12,0,0,0" Background="#121722" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                                <TextBlock x:Name="DryRunInfo" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                            </Border>
                        </DockPanel>
                        <ListBox x:Name="DryRunList" Grid.Row="1" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Журнал">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="История действий: что, куда и почему (включая откаты). Хранится в %LOCALAPPDATA%\Vitrines\history.jsonl" Foreground="{StaticResource TextDimBrush}"/>
                        <ListBox x:Name="HistoryList" Grid.Row="1" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Правила">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,10" ItemHeight="34">
                            <Button Content="＋ Добавить правило" Padding="10,6" Margin="0,0,8,8" Click="AddRule_Click" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"/>
                            <Button Content="Вкл / выкл" Padding="10,6" Margin="0,0,8,8" Click="ToggleRule_Click"/>
                            <Button Content="Удалить" Padding="10,6" Margin="0,0,8,8" Click="DeleteRule_Click"/>
                            <Button Content="Сохранить" Padding="10,6" Margin="0,0,8,8" Click="SaveRules_Click"/>
                        </WrapPanel>
                        <ListBox x:Name="RulesList" Grid.Row="1" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                        <Border Grid.Row="2" Margin="0,10,0,0" Background="#121722" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10">
                            <TextBlock Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                                       Text="Правила применяются сверху вниз (приоритет — порядок). Действие создаёт/использует витрину с указанным именем и физически сортирует файлы. Для тонкой настройки можно редактировать rules.json в папке данных."/>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <TextBlock Grid.Row="3" Margin="4,10,4,0" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                   Text="Автоматика выключена по умолчанию: включайте её осознанно. Проверяйте результат через Dry-run — каждое перемещение записывается в журнал и может быть отменено."/>
    </Grid>
</Window>
