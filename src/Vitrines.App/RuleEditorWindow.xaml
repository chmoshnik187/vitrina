<Window x:Class="Vitrines.App.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Правило сортировки" Width="800" Height="780" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#0F1115" Foreground="#E8EDF7">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C9CFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#161A22"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#2A3242"/>
        <SolidColorBrush x:Key="TextDim" Color="#9AA7BE"/>
        <SolidColorBrush x:Key="InputBrush" Color="#121722"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8EDF7"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#E8EDF7"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8EDF7"/><Setter Property="Margin" Value="0,2,8,6"/></Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#CFE0FF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" FontSize="13" Foreground="#CFE0FF" Margin="0,0,0,10"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6E7C95"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8EDF7"/>
            <Setter Property="Background" Value="#1C2230"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#243044"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#2A3852"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Редактор правила" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Все заданные группы условий должны совпасть (И); значения внутри списков — через запятую (ИЛИ). Правила применяются сверху вниз."
                       Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Основное">
                    <StackPanel>
                        <TextBlock Text="Название правила" Style="{StaticResource Label}"/>
                        <TextBox x:Name="NameBox"/>
                        <WrapPanel>
                            <CheckBox x:Name="EnabledCheck" Content="Включено"/>
                            <CheckBox x:Name="ExclusionCheck" Content="Правило-исключение: совпавшие элементы не трогать"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Условия совпадения">
                    <StackPanel>
                        <TextBlock Text="Расширения (например: jpg, png, pdf)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="ExtensionsBox"/>
                        <TextBlock Text="Типы элементов (отметьте нужные)" Style="{StaticResource Label}"/>
                        <WrapPanel Margin="0,2,0,6">
                            <CheckBox x:Name="KindFileCheck" Content="Файлы"/>
                            <CheckBox x:Name="KindFolderCheck" Content="Папки"/>
                            <CheckBox x:Name="KindShortcutCheck" Content="Ярлыки"/>
                            <CheckBox x:Name="KindApplicationCheck" Content="Программы"/>
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Имя содержит (через запятую)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="NameContainsBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Маски имени (* и ?)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="NamePatternsBox"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Регулярное выражение имени (необязательно)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="RegexBox"/>
                        <TextBlock Text="Только из источников (полные пути, по строке; пусто = любые)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="SourcesBox" AcceptsReturn="True" Height="54" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Мин. размер, КБ (пусто = нет)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="MinSizeBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Макс. размер, КБ (пусто = нет)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="MaxSizeBox"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Даты (включительно по выбранному дню)" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Изменён после" Style="{StaticResource Label}"/><DatePicker x:Name="ModifiedAfterPicker"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Изменён до" Style="{StaticResource Label}"/><DatePicker x:Name="ModifiedBeforePicker"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Создан после" Style="{StaticResource Label}"/><DatePicker x:Name="CreatedAfterPicker"/></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="Создан до" Style="{StaticResource Label}"/><DatePicker x:Name="CreatedBeforePicker"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Исключения внутри правила">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Исключить расширения" Style="{StaticResource Label}"/>
                                <TextBox x:Name="ExcludeExtensionsBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Исключить имя содержит" Style="{StaticResource Label}"/>
                                <TextBox x:Name="ExcludeNameBox"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Исключить маски имени" Style="{StaticResource Label}"/>
                        <TextBox x:Name="ExcludeMasksBox"/>
                        <TextBlock Text="Исключить папки (полные пути, по строке)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="ExcludeFoldersBox" AcceptsReturn="True" Height="54" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Действие">
                    <StackPanel>
                        <TextBlock Text="Что сделать при совпадении" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ActionBox" SelectionChanged="ActionBox_SelectionChanged">
                            <ComboBoxItem Content="Создать/найти витрину и поместить" Tag="CreateVitrineAndPlace"/>
                            <ComboBoxItem Content="Поместить в существующую витрину" Tag="PlaceInVitrine"/>
                            <ComboBoxItem Content="Переместить в папку" Tag="MoveToFolder"/>
                            <ComboBoxItem Content="Отправить в «Неразобранное»" Tag="SendToInbox"/>
                            <ComboBoxItem Content="Пропустить (ничего не делать)" Tag="Ignore"/>
                        </ComboBox>
                        <TextBlock x:Name="TargetLabel" Text="Имя витрины" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TargetBox"/>
                            <Button x:Name="BrowseFolderButton" Grid.Column="1" Content="Выбрать папку…" Margin="8,0,0,8" Padding="10,6"
                                    Click="BrowseFolder_Click" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock Text="Шаблон нового имени (необязательно). Токены: {name}, {ext}, {yyyy}, {MM}, {dd}, {HH}, {mm}, {ss}, {counter}"
                                   Style="{StaticResource Label}"/>
                        <TextBox x:Name="RenameTemplateBox"/>
                        <TextBlock Text="Например: {name} ({yyyy}-{MM}-{dd}) — расширение сохранится автоматически."
                                   Style="{StaticResource Hint}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="#121722" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,12,0">
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="12"/>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Отмена" Width="100" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Сохранить" Width="120" IsDefault="True" Click="Save_Click"
                        Background="#337C9CFF" BorderBrush="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
