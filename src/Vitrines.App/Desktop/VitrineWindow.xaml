<Window x:Class="Vitrines.App.Desktop.VitrineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Витрина" Width="340" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" ShowActivated="False"
        MinWidth="200" MinHeight="140" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver"
        LocationChanged="Window_LocationChanged" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="VAccent" Color="#7C9CFF"/>
    </Window.Resources>
    <Grid Margin="6">
        <!-- soft outer glow -->
        <Border CornerRadius="16" Background="#20000000" Margin="2,3,2,1"/>
        <Border x:Name="RootBorder" CornerRadius="16" BorderThickness="1" SnapsToDevicePixels="True">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#66FFFFFF" Offset="0"/>
                    <GradientStop Color="#22FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#447C9CFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC141922" Offset="0"/>
                    <GradientStop Color="#D610141C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="16,16,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Padding="12,9" Background="#14FFFFFF">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Переименовать витрину" Click="RenameVitrine_Click"/>
                            <Separator/>
                            <MenuItem Header="Сделать порталом (выбрать папку)…" Click="MakePortal_Click"/>
                            <MenuItem Header="Сделать коллекцией" Click="MakeCollection_Click"/>
                            <MenuItem Header="Открыть папку (портал/хранилище)" Click="OpenPortalFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="Менее прозрачная" Click="OpacityUp_Click"/>
                            <MenuItem Header="Более прозрачная" Click="OpacityDown_Click"/>
                            <Separator/>
                            <MenuItem Header="Удалить витрину" Click="DeleteVitrine_Click"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="8" Background="#227C9CFF" BorderBrush="#557C9CFF" BorderThickness="1" Padding="8,3" Margin="8,0,0,0">
                            <TextBlock x:Name="KindBadge" Foreground="#CFE0FF" FontSize="10" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource VAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TitleText" Foreground="#F4F7FF" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- accent line -->
                <Border Grid.Row="1" Height="1" Margin="12,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#007C9CFF" Offset="0"/>
                            <GradientStop Color="#AA7C9CFF" Offset="0.3"/>
                            <GradientStop Color="#007C9CFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,6,8,8">
                    <ItemsControl x:Name="ItemsPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="tile" Margin="5" Padding="7" Width="92" CornerRadius="12" Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                                        ToolTip="{Binding Path}" MouseLeftButtonUp="Item_MouseLeftButtonUp"
                                        MouseMove="Item_MouseMove" Tag="{Binding}" Cursor="Hand">
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="ItemMenu_Opened">
                                            <MenuItem Header="Открыть" Click="ItemOpen_Click"/>
                                            <MenuItem Header="Показать в папке" Click="ItemShowInFolder_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Закрепить / открепить" Click="ItemPin_Click"/>
                                            <MenuItem Header="Убрать из витрины" Click="ItemRemove_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="#557C9CFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Border Width="44" Height="44" CornerRadius="10" HorizontalAlignment="Center">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#28FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#14FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Image Source="{Binding Icon}" Width="34" Height="34" Stretch="Uniform"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding KindGlyph}" Foreground="#EAF0FF" FontSize="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#F2F6FF" FontSize="11"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxHeight="34" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PinMark}" Foreground="#F7D774" FontSize="10" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint" Grid.Row="2" Text="Пусто — перетащите сюда файлы&#x0a;или дождитесь авто-сортировки"
                           Foreground="#70A8B8D8" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="18" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
