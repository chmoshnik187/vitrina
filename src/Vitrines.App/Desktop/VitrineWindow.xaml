<Window x:Class="Vitrines.App.Desktop.VitrineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Витрина" Width="320" Height="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" ShowActivated="False"
        MinWidth="180" MinHeight="120" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver"
        LocationChanged="Window_LocationChanged" SizeChanged="Window_SizeChanged">
    <Border x:Name="RootBorder" CornerRadius="12" BorderThickness="1" BorderBrush="#55FFFFFF" SnapsToDevicePixels="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#C0182028" Offset="0"/>
                <GradientStop Color="#B010141A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок / область перетаскивания окна -->
            <Border Grid.Row="0" Background="#18FFFFFF" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" Padding="10,7">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Переименовать витрину" Click="RenameVitrine_Click"/>
                        <Separator/>
                        <MenuItem Header="Сделать порталом (выбрать папку)…" Click="MakePortal_Click"/>
                        <MenuItem Header="Сделать коллекцией" Click="MakeCollection_Click"/>
                        <MenuItem Header="Открыть папку (портал/хранилище)" Click="OpenPortalFolder_Click"/>
                        <Separator/>
                        <MenuItem Header="Удалить витрину" Click="DeleteVitrine_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <TextBlock x:Name="KindBadge" DockPanel.Dock="Right" Foreground="#99FFFFFF" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" Foreground="#F2FFFFFF" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="6">
                <ItemsControl x:Name="ItemsPanel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="6" Width="86" CornerRadius="8" Background="#10FFFFFF"
                                    ToolTip="{Binding Path}" MouseLeftButtonUp="Item_MouseLeftButtonUp"
                                    MouseMove="Item_MouseMove" Tag="{Binding}">
                                <Border.ContextMenu>
                                    <ContextMenu Opened="ItemMenu_Opened">
                                        <MenuItem Header="Открыть" Click="ItemOpen_Click"/>
                                        <MenuItem Header="Показать в папке" Click="ItemShowInFolder_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Закрепить / открепить" Click="ItemPin_Click"/>
                                        <MenuItem Header="Убрать из витрины" Click="ItemRemove_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#30FFFFFF" HorizontalAlignment="Center">
                                        <Grid>
                                            <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding KindGlyph}" Foreground="#EEFFFFFF" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#F0FFFFFF" FontSize="11"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxHeight="34" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding PinMark}" Foreground="#AAFFD966" FontSize="10" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="Пусто — перетащите сюда файлы или дождитесь авто-сортировки"
                       Foreground="#66FFFFFF" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" Margin="16" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
