<Window x:Class="Vitrines.App.Desktop.VitrineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Витрина" Width="340" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" ShowActivated="False"
        MinWidth="200" MinHeight="140" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver"
        LocationChanged="Window_LocationChanged" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="VAccent" Color="#7C9CFF"/>
        <Color x:Key="VAccentColor">#7C9CFF</Color>
        <SolidColorBrush x:Key="VText" Color="#F4F7FF"/>
        <SolidColorBrush x:Key="VTextDim" Color="#A8B8D8"/>
        <SolidColorBrush x:Key="VHeaderBg" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="VItemBg" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="VItemBorder" Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="VItemHover" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="VBadgeBg" Color="#227C9CFF"/>
        <SolidColorBrush x:Key="VBadgeBorder" Color="#557C9CFF"/>
        <SolidColorBrush x:Key="VEmpty" Color="#70A8B8D8"/>

        <Style x:Key="ItemTile" TargetType="Border">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource VItemBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VItemBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource VItemHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource VAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <!-- soft outer glow -->
        <Border CornerRadius="16" Background="#20000000" Margin="2,3,2,1"/>
        <Border x:Name="RootBorder" CornerRadius="16" BorderThickness="1" SnapsToDevicePixels="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#66FFFFFF" Offset="0"/>
                    <GradientStop Color="#22FFFFFF" Offset="0.5"/>
                    <GradientStop Color="{DynamicResource VAccentColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC141922" Offset="0"/>
                    <GradientStop Color="#D610141C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="16,16,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        Padding="12,9" Background="{DynamicResource VHeaderBg}">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Переименовать витрину" Click="RenameVitrine_Click"/>
                            <MenuItem x:Name="CollapseMenuItem" Header="Свернуть / развернуть" Click="ToggleCollapse_Click"/>
                            <Separator/>
                            <MenuItem Header="Сделать порталом (выбрать папку)…" Click="MakePortal_Click"/>
                            <MenuItem Header="Сделать коллекцией" Click="MakeCollection_Click"/>
                            <MenuItem Header="Обновить содержимое" Click="RefreshContents_Click"/>
                            <MenuItem Header="Открыть папку (портал/хранилище)" Click="OpenPortalFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="Менее прозрачная" Click="OpacityUp_Click"/>
                            <MenuItem Header="Более прозрачная" Click="OpacityDown_Click"/>
                            <Separator/>
                            <MenuItem Header="Удалить витрину" Click="DeleteVitrine_Click"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="8" Background="{DynamicResource VBadgeBg}"
                                BorderBrush="{DynamicResource VBadgeBorder}" BorderThickness="1" Padding="8,3" Margin="8,0,0,0">
                            <TextBlock x:Name="KindBadge" Foreground="{DynamicResource VTextDim}" FontSize="10" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource VAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TitleText" Foreground="{DynamicResource VText}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- accent line -->
                <Border x:Name="AccentLine" Grid.Row="1" Height="1" Margin="12,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#007C9CFF" Offset="0"/>
                            <GradientStop Color="{DynamicResource VAccentColor}" Offset="0.5"/>
                            <GradientStop Color="#007C9CFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,6,8,8">
                    <ItemsControl x:Name="ItemsPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="tile" Style="{StaticResource ItemTile}" Width="{Binding TileWidth}"
                                        Loaded="Tile_Loaded"
                                        ToolTip="{Binding Path}" MouseLeftButtonUp="Item_MouseLeftButtonUp"
                                        MouseMove="Item_MouseMove" Tag="{Binding}">
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="ItemMenu_Opened">
                                            <MenuItem Header="Открыть" Click="ItemOpen_Click"/>
                                            <MenuItem Header="Показать в папке" Click="ItemShowInFolder_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Закрепить / открепить" Click="ItemPin_Click"/>
                                            <MenuItem Header="Убрать из витрины" Click="ItemRemove_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <Border Width="44" Height="44" CornerRadius="10" HorizontalAlignment="Center">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#28FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#14FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Image Source="{Binding Icon}" Width="34" Height="34" Stretch="Uniform"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding KindGlyph}" Foreground="{DynamicResource VText}" FontSize="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource VText}" FontSize="{Binding NameFontSize}"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxHeight="36" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PinMark}" Foreground="#F7D774" FontSize="10" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint" Grid.Row="2" Text="Пусто — перетащите сюда файлы&#x0a;или дождитесь авто-сортировки"
                           Foreground="{DynamicResource VEmpty}" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="18" Visibility="Collapsed"/>

                <!-- мягкая вспышка при авто-размещении элемента -->
                <Border x:Name="PulseBorder" Grid.RowSpan="3" CornerRadius="15" BorderThickness="2"
                        BorderBrush="{DynamicResource VAccent}" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
